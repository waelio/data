{
  "name": "@waelio/data",
  "version": "1.0.7",
  "description": "Local secure reactive database accessible from a website",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.mjs",
      "require": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "keywords": [
    "database",
    "local",
    "secure",
    "reactive",
    "json",
    "typescript"
  ],
  "author": "waelio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waelio/data.git"
  },
  "bugs": {
    "url": "https://github.com/waelio/data/issues"
  },
  "homepage": "https://github.com/waelio/data#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/index.ts src/server.ts src/client.ts --format cjs,esm --dts",
    "test": "tsx --test test/*.test.ts",
    "e2e": "npm test",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
